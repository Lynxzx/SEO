#!/usr/bin/env node
var fs = require('fs');
var util = require('util');
textStats = require("../index.js");
var file = fs.readFileSync(process.argv[2],{ encoding:'UTF8' });

var stats = textStats.stats(file);
for(var section in stats){
	var text = "\t- ";

	text += section;
	text += ": ";
	text += stats[section];
	console.log(text);
}